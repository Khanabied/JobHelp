# JobSasa Career Optimization Platform - Environment Variables

# ================================
# CORE API CONFIGURATION  
# ================================

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini Configuration  
GEMINI_API_KEY=your_gemini_api_key_here

# Serper Search API Configuration
SERPER_API_KEY=your_serper_api_key_here

# ================================
# APPLICATION CONFIGURATION
# ================================

# JWT Secret for Authentication (Change in production)
JWT_SECRET=jobsasa-secret-key-change-in-production-2025

# Default AI Model Selection
MODEL=gemini-2.0-flash-exp

# ================================
# DATABASE CONFIGURATION
# ================================

# MongoDB Connection URL
MONGO_URL=mongodb://localhost:27017

# ================================
# ENVIRONMENT SETTINGS
# ================================

# Application Environment (development, staging, production)
APP_ENV=development

# Enable Debug Mode
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8001

# ================================
# FRONTEND CONFIGURATION  
# ================================

# Backend API URL for Frontend
REACT_APP_BACKEND_URL=http://localhost:8001

# ================================
# OPTIONAL SERVICES
# ================================

# File Upload Configuration
MAX_FILE_SIZE_MB=10

# Session Configuration
SESSION_TIMEOUT_HOURS=24

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# ================================
# INSTRUCTIONS
# ================================

# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual API keys above
# 3. Never commit .env file to version control
# 4. Required keys: GEMINI_API_KEY, OPENAI_API_KEY, SERPER_API_KEY
# 5. Optional: Customize other settings as needed